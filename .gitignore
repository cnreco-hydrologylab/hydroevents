# Private Miniconda install created by setup_conda_env.sh -p
/conda/

# Auto-generated activation helper created by setup_conda_env.sh
/activate_env.sh

# Python bytecode / cache
__pycache__/
*.py[cod]
*.pyo

# Packaging / build artifacts (created by `pip install -e .` and `python -m build`)
build/
dist/
*.egg-info/
*.egg
.eggs/

# Test artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Generated outputs (regenerated by running test/example.py, test/TEST.ipynb,
# example/demo_workflow.py, example/TEST_demo_workflow.ipynb)
test/output/
example/data/output_demo_workflow/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
